package starter.tools;

import java.io.IOException;
import java.io.PrintWriter;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.stream.Collectors;
import java.util.stream.Stream;

/**
 * Utility to generate a mapping from Gherkin steps (from feature files)
 * to their implementing Java step definition methods (annotated with
 * @Given/@When/@Then/@And/@But).
 *
 * Usage: run this as a simple Java main (from IDE or gradle) from the project root.
 * It will scan src/test/resources for .feature files and src/test/java for step definitions.
 * Output file: step-mapping.txt (project root).
 */
public class StepMappingGenerator {

    private static final String[] GHERKIN_KEYWORDS = {"Given", "When", "Then", "And", "But"};

    public static void main(String[] args) throws IOException {
        Path projectRoot = Paths.get(System.getProperty("user.dir"));
        Path featuresRoot = projectRoot.resolve("src/test/resources");
        Path stepsRoot = projectRoot.resolve("src/test/java");
        Path output = projectRoot.resolve("step-mapping.txt");

        List<FeatureStep> featureSteps = findFeatureSteps(featuresRoot);
        List<StepDefinition> stepDefinitions = findStepDefinitions(stepsRoot);

        Map<FeatureStep, List<MatchResult>> mappings = new HashMap<>();

        for (FeatureStep fs : featureSteps) {
            List<MatchResult> matches = new ArrayList<>();
            for (StepDefinition sd : stepDefinitions) {
                Matcher m = sd.pattern.matcher(fs.stepText);
                if (m.matches()) {
                    matches.add(new MatchResult(sd));
                }
            }
            mappings.put(fs, matches);
        }

        try (PrintWriter out = new PrintWriter(Files.newBufferedWriter(output, StandardCharsets.UTF_8))) {
            out.println("Gherkin step -> Implementing step definition(s)");
            out.println("Generated by StepMappingGenerator");
            out.println();

            out.println("Discovered step definitions:");
            for (StepDefinition sd : stepDefinitions) {
                out.println("  " + sd.className + "#" + sd.methodName + " => annotation=\"" + sd.annotation + "\"");
                out.println("     regex: " + sd.pattern.pattern());
                if (sd.methodSource != null) {
                    out.println("     method:");
                    for (String s : sd.methodSource.split("\n")) {
                        out.println("       " + s);
                    }
                }
            }
            out.println();

            for (FeatureStep fs : featureSteps) {
                out.println("Feature: " + fs.featureFile + " (line " + fs.lineNumber + ")");
                out.println("  " + fs.keyword + " " + fs.stepText);
                List<MatchResult> results = mappings.get(fs);
                if (results == null || results.isEmpty()) {
                    out.println("    -> NO IMPLEMENTATION FOUND");
                } else {
                    for (MatchResult mr : results) {
                        StepDefinition sd = mr.stepDefinition;
                        out.println("    -> " + sd.className + "#" + sd.methodName + " (file: " + sd.file + ")");
                        out.println("       annotation: \"" + sd.annotation + "\"");
                        if (sd.methodSource != null) {
                            out.println("       implementation:");
                            for (String s : sd.methodSource.split("\n")) {
                                out.println("         " + s);
                            }
                        }
                    }
                }
                out.println();
            }

            out.flush();
        }

        System.out.println("Step mapping written to: " + output.toAbsolutePath());
        System.out.println("Discovered " + stepDefinitions.size() + " step definitions.");
    }

    private static List<FeatureStep> findFeatureSteps(Path featuresRoot) throws IOException {
        List<FeatureStep> steps = new ArrayList<>();
        if (!Files.exists(featuresRoot)) return steps;

        try (Stream<Path> stream = Files.walk(featuresRoot)) {
            List<Path> files = stream.filter(Files::isRegularFile)
                    .filter(p -> p.toString().endsWith(".feature"))
                    .collect(Collectors.toList());

            Pattern stepLine = Pattern.compile("^\\s*(Given|When|Then|And|But)\\s+(.*)$", Pattern.CASE_INSENSITIVE);

            for (Path f : files) {
                List<String> lines = Files.readAllLines(f, StandardCharsets.UTF_8);
                for (int i = 0; i < lines.size(); i++) {
                    String line = lines.get(i);
                    Matcher m = stepLine.matcher(line);
                    if (m.find()) {
                        String kw = m.group(1);
                        String rest = m.group(2).trim();
                        steps.add(new FeatureStep(f.toString(), i + 1, kw, rest));
                    }
                }
            }
        }

        return steps;
    }

    private static List<StepDefinition> findStepDefinitions(Path stepsRoot) throws IOException {
        List<StepDefinition> defs = new ArrayList<>();
        if (!Files.exists(stepsRoot)) return defs;

        try (Stream<Path> stream = Files.walk(stepsRoot)) {
            List<Path> files = stream.filter(Files::isRegularFile)
                    .filter(p -> p.toString().endsWith(".java"))
                    .collect(Collectors.toList());

            Pattern annotationPattern = Pattern.compile("@(?:(Given|When|Then|And|But))\\s*\\(\\s*\"((?:\\\\\"|[^\"])*?)\"\\s*\\)", Pattern.MULTILINE);

            Pattern classPattern = Pattern.compile("class\\s+([A-Za-z0-9_]+)");

            for (Path f : files) {
                String content = new String(Files.readAllBytes(f), StandardCharsets.UTF_8);
                Matcher classMatcher = classPattern.matcher(content);
                String className = f.getFileName().toString();
                if (classMatcher.find()) className = classMatcher.group(1);

                Matcher annMatcher = annotationPattern.matcher(content);
                while (annMatcher.find()) {
                    String annotationRaw = annMatcher.group(2);
                    int searchStart = annMatcher.end();
                    String after = content.substring(searchStart);

                    // find next method declaration after the annotation
                    Pattern methodPattern = Pattern.compile("\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\([^)]*\\)\\s*\\{", Pattern.MULTILINE);
                    Matcher methodMatcher = methodPattern.matcher(after);
                    String methodName = "<unknown>";
                    String methodSource = null;
                    if (methodMatcher.find()) {
                        methodName = methodMatcher.group(1);
                        // compute absolute index of method start in the full content
                        int methodStartInAfter = methodMatcher.start();
                        int methodAbsIndex = searchStart + methodStartInAfter;
                        // find the opening brace position from methodAbsIndex onward
                        int openBraceIndex = content.indexOf('{', methodAbsIndex);
                        if (openBraceIndex >= 0) {
                            // find matching closing brace
                            int idx = openBraceIndex;
                            int depth = 0;
                            int endIndex = -1;
                            while (idx < content.length()) {
                                char c = content.charAt(idx);
                                if (c == '{') depth++;
                                else if (c == '}') {
                                    depth--;
                                    if (depth == 0) {
                                        endIndex = idx;
                                        break;
                                    }
                                }
                                idx++;
                            }
                            if (endIndex >= 0) {
                                // extract method starting from the annotation start so the annotation is included
                                int methodSourceStart = annMatcher.start();
                                methodSource = content.substring(methodSourceStart, endIndex + 1).trim();
                            } else {
                                // fallback: extract from annotation start until next two newlines
                                int methodSourceStart = annMatcher.start();
                                int nl = content.indexOf('\n', methodAbsIndex);
                                if (nl >= 0) {
                                    methodSource = content.substring(methodSourceStart, Math.min(content.length(), nl + 1)).trim();
                                }
                            }
                        }
                    }

                    String regex = annotationToRegex(annotationRaw);
                    Pattern compiled = Pattern.compile(regex, Pattern.CASE_INSENSITIVE);

                    defs.add(new StepDefinition(annotationRaw, compiled, className, methodName, f.toString(), methodSource));
                }
            }
        }

        return defs;
    }

    private static String annotationToRegex(String annotation) {
        // We'll replace Cucumber placeholders (e.g. {actor}, {string}) with a token,
        // then split the annotation on that token, quote each literal segment and
        // insert a capturing group between them. This avoids quoting injected groups.
        String token = "__CUCUMBER_PARAM__";
        String withTokens = annotation.replaceAll("\\{[^}]+\\}", token);

        String[] parts = withTokens.split(Pattern.quote(token), -1);
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < parts.length; i++) {
            sb.append(Pattern.quote(parts[i]));
            if (i < parts.length - 1) {
                sb.append("(.+?)"); // non-greedy capture for each placeholder
            }
        }

        return "^" + sb.toString() + "$";
    }

    private static class FeatureStep {
        final String featureFile;
        final int lineNumber;
        final String keyword;
        final String stepText;

        FeatureStep(String featureFile, int lineNumber, String keyword, String stepText) {
            this.featureFile = featureFile;
            this.lineNumber = lineNumber;
            this.keyword = keyword;
            this.stepText = stepText;
        }
    }

    private static class StepDefinition {
        final String annotation; // raw annotation value
        final Pattern pattern;   // compiled regex to match feature step
        final String className;
        final String methodName;
        final String file;
        final String methodSource;

        StepDefinition(String annotation, Pattern pattern, String className, String methodName, String file, String methodSource) {
            this.annotation = annotation;
            this.pattern = pattern;
            this.className = className;
            this.methodName = methodName;
            this.file = file;
            this.methodSource = methodSource;
        }
    }

    private static class MatchResult {
        final StepDefinition stepDefinition;

        MatchResult(StepDefinition sd) {
            this.stepDefinition = sd;
        }
    }
}
