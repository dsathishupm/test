public class ExcelReader {

    public List<Map<String, String>> getData(String filePath, String sheetName) throws Exception {
        List<Map<String, String>> dataList = new ArrayList<>();
        
        // Open the Workbook
        Workbook workbook = WorkbookFactory.create(new File(filePath));
        Sheet sheet = workbook.getSheet(sheetName);
        
        Row headerRow = sheet.getRow(0); // Assuming first row is header
        int totalRows = sheet.getPhysicalNumberOfRows();
        int totalCols = headerRow.getPhysicalNumberOfCells();

        // Iterate rows (starting from 1 to skip header)
        for (int i = 1; i < totalRows; i++) {
            Row currentRow = sheet.getRow(i);
            Map<String, String> rowMap = new HashMap<>();

            for (int j = 0; j < totalCols; j++) {
                String headerName = headerRow.getCell(j).getStringCellValue();
                Cell cell = currentRow.getCell(j);
                
                // Format cell content as String regardless of type
                DataFormatter formatter = new DataFormatter();
                rowMap.put(headerName, formatter.formatCellValue(cell));
            }
            dataList.add(rowMap);
        }
        workbook.close();
        return dataList;
    }
}

