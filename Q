public class FindHighestNumber {

    /**
     * Finds the maximum number in an integer array by iterating through the elements.
     * * @param arr The integer array to search through.
     * @return The largest integer found in the array.
     * @throws IllegalArgumentException if the array is null or empty.
     */
    public static int findMax(int[] arr) {
        // 1. Handle edge cases: null or empty array
        if (arr == null || arr.length == 0) {
            // In a real-world scenario, you might return Integer.MIN_VALUE or throw an exception.
            throw new IllegalArgumentException("The array cannot be null or empty.");
        }

        // 2. Initialize the maximum value variable
        // Start by assuming the first element is the largest.
        int max = arr[0]; 

        // 3. Iterate through the rest of the array (starting from the second element at index 1)
        for (int i = 1; i < arr.length; i++) {
            // 4. Compare the current element with the current maximum
            if (arr[i] > max) {
                // If the current element is larger, update the maximum
                max = arr[i];
            }
        }
        
        return max;
    }

