public class StringSwap {
    public static void swap(String a, String b) {
        System.out.println("Before swap: A = " + a + ", B = " + b);
        
        // 1. Concatenate both strings and store in A
        a = a + b; // A now holds "HelloWorld"

        // 2. Extract original A from the combined string and store in B
        // (A.length() - B.length()) gives the length of original A
        b = a.substring(0, a.length() - b.length()); // B now holds "Hello"

        // 3. Extract original B from the combined string and store in A
        a = a.substring(b.length()); // A now holds "World"

        System.out.println("After swap: A = " + a + ", B = " + b);
    }

    public static void main(String[] args) {
        String str1 = "Hello";
        String str2 = "World";
        swap(str1, str2);
    }
}
