import io.appium.java_client.AppiumDriver;
import org.openqa.selenium.WebDriver;
import java.util.HashMap;
import java.util.Map;

public class DriverManager {
    // ThreadLocal variables to hold unique driver instances per thread
    private static final ThreadLocal<WebDriver> WEB_DRIVER_THREAD_LOCAL = new ThreadLocal<>();
    private static final ThreadLocal<AppiumDriver> APPIUM_DRIVER_THREAD_LOCAL = new ThreadLocal<>();
    
    // An optional map to keep track of which driver type is associated with the current thread
    private static final ThreadLocal<String> DRIVER_TYPE = new ThreadLocal<>();

    public static WebDriver getWebDriver() {
        return WEB_DRIVER_THREAD_LOCAL.get();
    }

    public static AppiumDriver getAppiumDriver() {
        return APPIUM_DRIVER_THREAD_LOCAL.get();
    }
    
    public static void setWebDriver(WebDriver driver) {
        WEB_DRIVER_THREAD_LOCAL.set(driver);
        DRIVER_TYPE.set("web");
    }

    public static void setAppiumDriver(AppiumDriver driver) {
        APPIUM_DRIVER_THREAD_LOCAL.set(driver);
        DRIVER_TYPE.set("appium");
    }

    public static void quitDriver() {
        String type = DRIVER_TYPE.get();
        if (type != null) {
            if (type.equals("web") && WEB_DRIVER_THREAD_LOCAL.get() != null) {
                WEB_DRIVER_THREAD_LOCAL.get().quit();
                WEB_DRIVER_THREAD_LOCAL.remove();
            } else if (type.equals("appium") && APPIUM_DRIVER_THREAD_LOCAL.get() != null) {
                APPIUM_DRIVER_THREAD_LOCAL.get().quit();
                APPIUM_DRIVER_THREAD_LOCAL.remove();
            }
            DRIVER_TYPE.remove(); // Essential to prevent memory leaks
        }
    }

