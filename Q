Difference between String Builder and String Buffer?	StringBuffer is synchronized (thread-safe) and slower. StringBuilder is non-synchronized (not thread-safe) and faster. Use StringBuilder in single-threaded environments.
public class MutableStringDemo {

    public static void main(String[] args) {
        // 1. StringBuilder: Faster, Non-Synchronized (Best for single-threaded tasks)
        System.out.println("--- 1. StringBuilder Demo (Faster) ---");
        
        StringBuilder sb = new StringBuilder("Initial");
        System.out.println("Initial StringBuilder: " + sb);

        // Mutable operation: The original object is modified, no new object is created.
        sb.append(" Content"); 
        sb.insert(0, "New ");
        sb.reverse();
        
        System.out.println("Modified StringBuilder: " + sb);
        
        // 2. StringBuffer: Slower, Synchronized (Required for multi-threaded tasks)
        System.out.println("\n--- 2. StringBuffer Demo (Thread-Safe) ---");

        StringBuffer sbuf = new StringBuffer("Start");
        System.out.println("Initial StringBuffer: " + sbuf);

        // Mutable operations are synchronized internally
        sbuf.append(" Data"); 
        sbuf.delete(0, 5); // Deletes "Start"
        sbuf.insert(0, "Fresh");
        
        System.out.println("Modified StringBuffer: " + sbuf);
        
        // 3. Performance Test (Conceptual Difference)
        // Note: Running a formal benchmark is complex, but this illustrates the difference in large loops.
        
        long startTime = System.nanoTime();
        performAppends(new StringBuilder());
        long endTime = System.nanoTime();
        System.out.println("\nStringBuilder time (ms): " + (endTime - startTime) / 1000000.0);

        startTime = System.nanoTime();
        performAppends(new StringBuffer());
        endTime = System.nanoTime();
        System.out.println("StringBuffer time (ms): " + (endTime - startTime) / 1000000.0);
    }

    /** Helper method to run many appends for performance comparison */
    private static void performAppends(Appendable mutableString) {
        for (int i = 0; i < 50000; i++) {
            if (mutableString instanceof StringBuilder) {
                ((StringBuilder) mutableString).append("a");
            } else if (mutableString instanceof StringBuffer) {
                ((StringBuffer) mutableString).append("a");
            }
        }
    }
}


